import { LineEdit, TextEdit, ScrollView, CheckBox, ComboBox } from "std-widgets.slint";
import { ActionButton as Button } from "components/action-button.slint";
import { Metric } from "components/metric.slint";
import { Field } from "components/field.slint";
import { CaptionButton } from "components/caption-button.slint";

export component AppWindow inherits Window {
    title: "TeacherOA 服务管理";
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 1120px;
    preferred-height: 800px;
    min-width: 920px;
    min-height: 720px;
    background: #f5f7fb;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;

    in property <string> status: "未启动";
    in property <color> status-color: #718096;
    in property <string> pid: "—";
    in property <string> uptime: "—";
    in property <string> dependencies: "等待服务启动";
    in property <string> version: "—";
    in property <bool> running: false;
    in property <bool> connected: false;
    in property <bool> busy: false;
    in property <bool> can-force: false;
    in property <string> feedback;
    in property <bool> feedback-error: false;
    in property <string> logs;
    in-out property <string> log-filter;
    in-out property <bool> log-paused: false;
    in-out property <bool> follow-logs: true;
    in property <bool> config-loaded: false;
    in property <bool> restart-required: false;
    in-out property <string> executable;
    in-out property <string> working-directory;
    in-out property <string> config-path;
    in-out property <string> base-url;
    in-out property <string> host;
    in-out property <string> port;
    in-out property <string> workers;
    in-out property <string> pool-size;
    in-out property <int> log-level-index: 2;
    in-out property <int> log-format-index: 0;
    in-out property <bool> launcher-dirty: false;
    in-out property <bool> config-dirty: false;
    in-out property <int> page: 0;


    callback start-service;
    callback stop-service;
    callback restart-service;
    callback force-stop;
    callback refresh-status;
    callback clear-logs;
    callback export-logs;
    callback open-admin;
    callback save-launcher;
    callback read-config;
    callback save-config;
    callback choose-path(int);
    callback confirm-action(int);
    callback minimize-window;
    callback toggle-maximize;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        HorizontalLayout {
            height: 56px;
            Rectangle {
                background: #ffffff;
                WindowMoveArea {
                    HorizontalLayout {
                        padding-left: 24px;
                        spacing: 12px;
                        Text { text: "TeacherOA"; font-size: 18px; font-weight: 700; color: #182b43; vertical-alignment: center; }
                        Text { text: "服务管理"; font-size: 12px; color: #69788b; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 0;
                background: #ffffff;
                HorizontalLayout {
                    CaptionButton { kind: 0; label: "最小化"; clicked => { root.minimize-window(); } }
                    CaptionButton { kind: 1; label: "最大化或还原"; clicked => { root.toggle-maximize(); } }
                    CaptionButton { kind: 2; label: "关闭"; clicked => { root.close(); } }
                }
            }
        }
        Rectangle { height: 1px; background: #e1e7ef; }
        HorizontalLayout {
            padding: 0px;
            spacing: 0px;
            Rectangle {
                width: 174px;
                background: #ffffff;
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    Button { text: "运行概览"; primary: root.page == 0; checkable: false; width: 138px; clicked => { root.page = 0; } }
                    Button { text: "运行日志"; primary: root.page == 1; checkable: false; width: 138px; clicked => { root.page = 1; } }
                    Button { text: "配置管理"; primary: root.page == 2; checkable: false; width: 138px; clicked => { root.page = 2; } }
                    Rectangle { vertical-stretch: 1; }
                    Text { text: "Windows 管理端"; font-size: 12px; color: #8491a2; }
                }
            }
            Rectangle { width: 1px; background: #e1e7ef; }
            VerticalLayout {
                padding: 26px;
                spacing: 18px;
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: root.page == 0 ? "运行概览" : root.page == 1 ? "运行日志" : "配置管理"; font-size: 25px; font-weight: 600; color: #182b43; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 6px;
                        padding-right: 8px;
                        VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.status-color; } }
                        Text { text: root.status; color: root.status-color; vertical-alignment: center; }
                    }
                    VerticalLayout { alignment: center; Button { text: "打开后台"; enabled: root.connected; clicked => { root.open-admin(); } } }
                    VerticalLayout { alignment: center; Button { text: "刷新状态"; enabled: root.running && !root.busy; clicked => { root.refresh-status(); } } }
                }
                if root.feedback != "": Rectangle {
                    min-height: 44px;
                    background: root.feedback-error ? #fff1ef : #edf6f2;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 12px;
                        Text { text: root.feedback; color: root.feedback-error ? #a33329 : #24684e; wrap: word-wrap; }
                    }
                }
                if root.page == 0: VerticalLayout {
                    spacing: 22px;
                    HorizontalLayout {
                        spacing: 14px;
                        Metric { label: "服务状态"; value: root.status; value-color: root.status-color; }
                        Metric { label: "进程 PID"; value: root.pid; }
                        Metric { label: "运行时长"; value: root.uptime; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Button { text: "启动服务"; primary: true; enabled: !root.running && !root.busy; clicked => { root.start-service(); } }
                        Button { text: "停止服务"; enabled: root.connected && !root.busy; clicked => { root.confirm-action(1); } }
                        Button { text: "重启服务"; enabled: root.connected && !root.busy && !root.config-dirty && !root.launcher-dirty; clicked => { root.confirm-action(2); } }
                        Rectangle { horizontal-stretch: 1; }
                        if root.can-force: Button { text: "强制结束"; enabled: !root.busy; clicked => { root.confirm-action(3); } }
                    }
                    Rectangle { height: 1px; background: #e1e7ef; }
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: "依赖状态"; font-size: 16px; font-weight: 600; color: #182b43; }
                        Text { text: root.dependencies; color: #536479; wrap: word-wrap; }
                        Text { text: "服务地址  " + root.base-url; color: #536479; overflow: elide; }
                        Text { text: "服务版本  " + root.version; color: #536479; }
                    }
                    VerticalLayout {
                        spacing: 10px;
                        Text { text: "最近日志"; font-size: 16px; font-weight: 600; color: #182b43; }
                        TextEdit { text: root.logs; read-only: true; font-size: 12px; font-family: "Consolas"; accessible-label: "最近运行日志"; }
                    }
                }
                if root.page == 1: VerticalLayout {
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 10px;
                        LineEdit { text <=> root.log-filter; placeholder-text: "筛选日志"; accessible-label: "筛选日志"; }
                        CheckBox { text: "暂停"; checked <=> root.log-paused; }
                        CheckBox { text: "跟随"; checked <=> root.follow-logs; }
                        Button { text: "导出"; clicked => { root.export-logs(); } }
                        Button { text: "清空视图"; clicked => { root.clear-logs(); } }
                    }
                    Rectangle {
                        background: #ffffff;
                        border-width: 1px;
                        border-color: #e1e7ef;
                        border-radius: 6px;
                        clip: true;
                        log-view := ScrollView {
                            changed content-height => { if root.follow-logs { self.content-y = min(0px, self.visible-height - self.content-height); } }
                            content-height: log-text.preferred-height + 24px;
                            content-width: self.visible-width;
                            log-text := Text {
                                x: 12px;
                                y: 12px;
                                width: parent.width - 24px;
                                text: root.logs == "" ? "暂无日志" : root.logs;
                                color: root.logs == "" ? #8491a2 : #263b53;
                                font-family: "Consolas";
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                if root.page == 2: ScrollView {
                    VerticalLayout {
                        spacing: 18px;
                        padding-right: 12px;
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "启动设置"; font-size: 17px; font-weight: 600; color: #182b43; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Button { text: "保存启动设置"; enabled: !root.running && !root.busy; clicked => { root.save-launcher(); } }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Field { label: "服务程序"; value <=> root.executable; enabled: !root.running && !root.busy; edited => { root.launcher-dirty = true; } }
                            VerticalLayout { alignment: end; Button { text: "选择程序"; width: 112px; enabled: !root.running && !root.busy; clicked => { root.choose-path(0); } } }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Field { label: "工作目录"; value <=> root.working-directory; enabled: !root.running && !root.busy; edited => { root.launcher-dirty = true; } }
                            VerticalLayout { alignment: end; Button { text: "选择目录"; width: 112px; enabled: !root.running && !root.busy; clicked => { root.choose-path(1); } } }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Field { label: "配置文件"; value <=> root.config-path; enabled: !root.running && !root.busy; edited => { root.launcher-dirty = true; } }
                            VerticalLayout { alignment: end; Button { text: "选择文件"; width: 112px; enabled: !root.running && !root.busy; clicked => { root.choose-path(2); } } }
                        }
                        Field { label: "本机服务地址"; value <=> root.base-url; enabled: !root.running && !root.busy; edited => { root.launcher-dirty = true; } }
                        Rectangle { height: 1px; background: #e1e7ef; }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "服务配置"; font-size: 17px; font-weight: 600; color: #182b43; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Button { text: "重新读取"; enabled: root.connected && !root.busy; clicked => { if root.config-dirty { root.confirm-action(5); } else { root.read-config(); } } }
                            Button { text: "保存服务配置"; primary: true; enabled: root.connected && root.config-loaded && !root.busy; clicked => { root.save-config(); } }
                        }
                        if !root.connected: Text { text: "启动服务后可读取和保存服务配置"; color: #69788b; }
                        if root.restart-required && root.config-loaded: Text { text: "已保存的配置将在下次启动时生效"; color: #94611b; }
                        HorizontalLayout {
                            spacing: 16px;
                            Field { label: "监听 IP"; value <=> root.host; enabled: root.config-loaded && root.connected && !root.busy; edited => { root.config-dirty = true; } }
                            Field { label: "监听端口"; value <=> root.port; enabled: root.config-loaded && root.connected && !root.busy; edited => { root.config-dirty = true; } }
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            Field { label: "工作线程（0为自动）"; value <=> root.workers; enabled: root.config-loaded && root.connected && !root.busy; edited => { root.config-dirty = true; } }
                            Field { label: "数据库连接池"; value <=> root.pool-size; enabled: root.config-loaded && root.connected && !root.busy; edited => { root.config-dirty = true; } }
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                spacing: 7px;
                                Text { text: "日志级别"; color: #536479; font-size: 13px; }
                                ComboBox { model: ["trace", "debug", "info", "warn", "error"]; current-index <=> root.log-level-index; enabled: root.config-loaded && root.connected && !root.busy; selected => { root.config-dirty = true; } }
                            }
                            VerticalLayout {
                                spacing: 7px;
                                Text { text: "日志格式"; color: #536479; font-size: 13px; }
                                ComboBox { model: ["text", "json"]; current-index <=> root.log-format-index; enabled: root.config-loaded && root.connected && !root.busy; selected => { root.config-dirty = true; } }
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 30px;
            background: #ffffff;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                Text { text: "TeacherOA · 服务管理"; font-size: 11px; color: #8491a2; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.launcher-dirty || root.config-dirty ? "有未保存的修改" : ""; font-size: 11px; color: #94611b; vertical-alignment: center; }
            }
        }
    }
}
