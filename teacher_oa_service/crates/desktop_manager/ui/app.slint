import { ScrollView } from "std-widgets.slint";
import { Theme } from "tokens.slint";
import { ActionButton as Button } from "components/action-button.slint";
import { Metric } from "components/metric.slint";
import { Field } from "components/field.slint";
import { CaptionButton } from "components/caption-button.slint";
import { NavItem } from "components/nav-item.slint";
import { SelectBox } from "components/select-box.slint";
import { TextInputField } from "components/text-input.slint";
import { ToggleCheck } from "components/toggle-check.slint";

export component AppWindow inherits Window {
    title: "TeacherOA 服务管理";
    no-frame: true;
    resize-border-width: root.is-maximized ? 0px : 6px;
    preferred-width: 1120px;
    preferred-height: 800px;
    min-width: 920px;
    min-height: 720px;
    background: Theme.surface;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: Theme.text-sm;

    in property <string> status: "未启动";
    // §5.6 Semantic status tones mapped strictly to WCAG AA-verified Theme tokens (P0-3).
    in property <int> status-tone: 0;
    private property <color> status-color: root.status-tone == 1
        ? Theme.action-subtle-text
        : root.status-tone == 2
            ? Theme.success-text
            : root.status-tone == 3
                ? Theme.warning-text
                : root.status-tone == 4
                    ? Theme.danger-text
                    : Theme.text-muted;
    in property <string> pid: "—";
    in property <string> uptime: "—";
    in property <string> dependencies: "等待服务启动";
    in property <string> version: "—";
    in property <bool> running: false;
    in property <bool> connected: false;
    in property <bool> busy: false;
    in property <bool> can-force: false;
    in property <string> feedback;
    in property <bool> feedback-error: false;
    in property <string> logs;
    in-out property <string> log-filter;
    in-out property <bool> log-paused: false;
    in-out property <bool> follow-logs: true;
    in property <bool> config-loaded: false;
    in property <bool> restart-required: false;
    in-out property <string> executable;
    in-out property <string> working-directory;
    in-out property <string> config-path;
    in-out property <string> base-url;
    in-out property <string> host;
    in-out property <string> port;
    in-out property <string> workers;
    in-out property <string> pool-size;
    in-out property <int> log-level-index: 2;
    in-out property <int> log-format-index: 0;
    in-out property <bool> launcher-dirty: false;
    in-out property <bool> config-dirty: false;
    in-out property <bool> is-maximized: false;
    in-out property <int> page: 0;

    callback start-service;
    callback stop-service;
    callback restart-service;
    callback force-stop;
    callback refresh-status;
    callback clear-logs;
    callback export-logs;
    callback open-admin;
    callback save-launcher;
    callback read-config;
    callback save-config;
    callback choose-path(int);
    callback confirm-action(int);
    callback minimize-window;
    callback toggle-maximize;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        // Top title bar
        HorizontalLayout {
            height: 48px;
            Rectangle {
                background: Theme.surface-raised;
                WindowMoveArea {
                    TouchArea {
                        double-clicked => { root.toggle-maximize(); }
                        HorizontalLayout {
                            padding-left: Theme.space-4;
                            spacing: Theme.space-2;
                            VerticalLayout {
                                alignment: center;
                                // §7.3.3 Simplified high-contrast graduation-cap mark unified with Web & favicon (P2-5).
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.primary-500;
                                    Path {
                                        x: 3px;
                                        y: 3px;
                                        width: 16px;
                                        height: 16px;
                                        viewbox-width: 64;
                                        viewbox-height: 64;
                                        commands: "M 32 13 L 8 25 L 32 37 L 50 28 L 50 41 L 54 41 L 54 26 L 56 25 Z M 18 33.5 L 18 44.5 C 18 49.2 24.3 52 32 52 C 39.7 52 46 49.2 46 44.5 L 46 33.5 L 32 40.5 Z";
                                        fill: #ffffff;
                                    }
                                }
                            }
                            Text {
                                text: "TeacherOA";
                                font-size: Theme.text-base;
                                font-weight: 600;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "服务管理";
                                font-size: Theme.text-xs;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 0;
                background: Theme.surface-raised;
                HorizontalLayout {
                    CaptionButton { kind: 0; label: "最小化"; clicked => { root.minimize-window(); } }
                    CaptionButton { kind: 1; maximized: root.is-maximized; label: root.is-maximized ? "向下还原" : "最大化"; clicked => { root.toggle-maximize(); } }
                    CaptionButton { kind: 2; label: "关闭"; clicked => { root.close(); } }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        HorizontalLayout {
            padding: 0px;
            spacing: 0px;
            // §2.4.a De-emphasized sidebar on surface-subtle
            Rectangle {
                width: 192px;
                background: Theme.surface-subtle;
                VerticalLayout {
                    padding: Theme.space-3;
                    spacing: Theme.space-1;
                    NavItem { label: "运行概览"; active: root.page == 0; clicked => { root.page = 0; } }
                    NavItem { label: "运行日志"; active: root.page == 1; clicked => { root.page = 1; } }
                    NavItem { label: "配置管理"; active: root.page == 2; clicked => { root.page = 2; } }
                    Rectangle { vertical-stretch: 1; }
                    Text {
                        text: "Windows 管理端";
                        font-size: Theme.text-xs;
                        color: Theme.text-muted;
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.border; }
            VerticalLayout {
                padding: Theme.space-6;
                spacing: Theme.space-4;
                // Page header
                HorizontalLayout {
                    spacing: Theme.space-3;
                    Text {
                        text: root.page == 0 ? "运行概览" : root.page == 1 ? "运行日志" : "配置管理";
                        font-size: Theme.text-xl;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.page != 0: HorizontalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        padding-right: Theme.space-1;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 26px;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface-raised;
                                HorizontalLayout {
                                    padding-left: Theme.space-2;
                                    padding-right: Theme.space-2;
                                    spacing: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.status-color; }
                                    }
                                    Text {
                                        text: root.status;
                                        font-size: Theme.text-xs;
                                        font-weight: 600;
                                        color: root.status-color;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    VerticalLayout { alignment: center; Button { text: "打开后台"; enabled: root.connected; clicked => { root.open-admin(); } } }
                    VerticalLayout { alignment: center; Button { text: "刷新状态"; enabled: root.running && !root.busy; clicked => { root.refresh-status(); } } }
                }
                // §5.6.1 + §8.2 Feedback banner with left accent bar and flipped light surface
                if root.feedback != "": Rectangle {
                    min-height: 40px;
                    background: root.feedback-error ? Theme.danger-surface : Theme.success-surface;
                    border-width: 1px;
                    border-color: root.feedback-error ? Theme.danger-border : Theme.success-border;
                    border-radius: Theme.radius-md;
                    clip: true;
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 3px;
                        height: parent.height;
                        background: root.feedback-error ? Theme.danger : Theme.success;
                    }
                    HorizontalLayout {
                        padding-left: Theme.space-4;
                        padding-right: Theme.space-4;
                        padding-top: Theme.space-2;
                        padding-bottom: Theme.space-2;
                        Text {
                            text: root.feedback;
                            color: root.feedback-error ? Theme.danger-text : Theme.success-text;
                            wrap: word-wrap;
                        }
                    }
                }
                if root.page == 0: VerticalLayout {
                    spacing: Theme.space-4;
                    HorizontalLayout {
                        spacing: Theme.space-3;
                        Metric { label: "服务状态"; value: root.status; value-color: root.status-color; show-dot: true; }
                        Metric { label: "进程 PID"; value: root.pid; }
                        Metric { label: "运行时长"; value: root.uptime; }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        Button { text: "启动服务"; primary: !root.running; enabled: !root.running && !root.busy; clicked => { root.start-service(); } }
                        Button { text: "停止服务"; enabled: root.connected && !root.busy; clicked => { root.confirm-action(1); } }
                        Button { text: "重启服务"; enabled: root.connected && !root.busy && !root.config-dirty && !root.launcher-dirty; clicked => { root.confirm-action(2); } }
                        Rectangle { horizontal-stretch: 1; }
                        if root.can-force: Button { text: "强制结束"; danger: true; enabled: !root.busy; clicked => { root.confirm-action(3); } }
                    }
                    Rectangle {
                        background: Theme.surface-raised;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-lg;
                        drop-shadow-blur: 3px;
                        drop-shadow-offset-y: 1px;
                        drop-shadow-color: Theme.shadow-subtle;
                        VerticalLayout {
                            padding: Theme.space-4;
                            spacing: Theme.space-3;
                            Text { text: "依赖与环境"; font-size: Theme.text-base; font-weight: 600; color: Theme.text; }
                            HorizontalLayout {
                                spacing: Theme.space-6;
                                VerticalLayout {
                                    spacing: Theme.space-1;
                                    horizontal-stretch: 2;
                                    Text { text: "依赖状态"; font-size: Theme.text-xs; font-weight: 600; color: Theme.text-muted; }
                                    Text { text: root.dependencies; font-size: Theme.text-sm; color: Theme.text; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    spacing: Theme.space-1;
                                    horizontal-stretch: 1;
                                    Text { text: "服务地址"; font-size: Theme.text-xs; font-weight: 600; color: Theme.text-muted; }
                                    Text { text: root.base-url; font-size: Theme.text-sm; color: Theme.text; overflow: elide; }
                                }
                                VerticalLayout {
                                    spacing: Theme.space-1;
                                    horizontal-stretch: 0;
                                    Text { text: "服务版本"; font-size: Theme.text-xs; font-weight: 600; color: Theme.text-muted; }
                                    Text { text: root.version; font-size: Theme.text-sm; color: Theme.text; }
                                }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.surface-raised;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-lg;
                        drop-shadow-blur: 3px;
                        drop-shadow-offset-y: 1px;
                        drop-shadow-color: Theme.shadow-subtle;
                        VerticalLayout {
                            padding: Theme.space-4;
                            spacing: Theme.space-3;
                            Text { text: "最近日志"; font-size: Theme.text-base; font-weight: 600; color: Theme.text; }
                            Rectangle {
                                vertical-stretch: 1;
                                background: Theme.surface-subtle;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: Theme.radius-md;
                                clip: true;
                                recent-log-view := ScrollView {
                                    content-height: recent-log-text.preferred-height + 24px;
                                    content-width: self.visible-width;
                                    if root.logs == "": Text {
                                        x: Theme.space-3;
                                        y: Theme.space-3;
                                        text: "暂无运行日志";
                                        color: Theme.text-muted;
                                        font-family: "Consolas";
                                        font-size: Theme.text-xs;
                                    }
                                    recent-log-text := TextInput {
                                        x: Theme.space-3;
                                        y: Theme.space-3;
                                        width: parent.width - 24px;
                                        text: root.logs;
                                        color: Theme.text;
                                        font-family: "Consolas";
                                        font-size: Theme.text-xs;
                                        single-line: false;
                                        read-only: true;
                                        wrap: word-wrap;
                                        accessible-label: "最近运行日志";
                                    }
                                }
                            }
                        }
                    }
                }
                if root.page == 1: VerticalLayout {
                    spacing: Theme.space-4;
                    Rectangle {
                        background: Theme.surface-raised;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-lg;
                        drop-shadow-blur: 3px;
                        drop-shadow-offset-y: 1px;
                        drop-shadow-color: Theme.shadow-subtle;
                        HorizontalLayout {
                            padding: Theme.space-3;
                            spacing: Theme.space-3;
                            TextInputField { text <=> root.log-filter; placeholder-text: "筛选日志"; accessible-name: "筛选日志"; }
                            ToggleCheck { text: "暂停"; checked <=> root.log-paused; }
                            ToggleCheck { text: "跟随"; checked <=> root.follow-logs; }
                            Button { text: "导出"; enabled: !root.busy; clicked => { root.export-logs(); } }
                            Button { text: "清空视图"; clicked => { root.clear-logs(); } }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.surface-raised;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-lg;
                        drop-shadow-blur: 3px;
                        drop-shadow-offset-y: 1px;
                        drop-shadow-color: Theme.shadow-subtle;
                        VerticalLayout {
                            padding: Theme.space-4;
                            Rectangle {
                                background: Theme.surface-subtle;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: Theme.radius-md;
                                clip: true;
                                log-view := ScrollView {
                                    changed content-height => { if root.follow-logs { self.content-y = min(0px, self.visible-height - self.content-height); } }
                                    content-height: log-text.preferred-height + 24px;
                                    content-width: self.visible-width;
                                    if root.logs == "": Text {
                                        x: Theme.space-3;
                                        y: Theme.space-3;
                                        text: "暂无日志";
                                        color: Theme.text-muted;
                                        font-family: "Consolas";
                                        font-size: Theme.text-xs;
                                    }
                                    log-text := TextInput {
                                        x: Theme.space-3;
                                        y: Theme.space-3;
                                        width: parent.width - 24px;
                                        text: root.logs;
                                        color: Theme.text;
                                        font-family: "Consolas";
                                        font-size: Theme.text-xs;
                                        single-line: false;
                                        read-only: true;
                                        wrap: word-wrap;
                                        accessible-label: "运行日志";
                                    }
                                }
                            }
                        }
                    }
                }
                if root.page == 2: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        spacing: Theme.space-4;
                        padding-right: Theme.space-3;
                        // Card 1: Launcher settings
                        Rectangle {
                            background: Theme.surface-raised;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: Theme.radius-lg;
                            drop-shadow-blur: 3px;
                            drop-shadow-offset-y: 1px;
                            drop-shadow-color: Theme.shadow-subtle;
                            VerticalLayout {
                                padding: Theme.space-6;
                                spacing: Theme.space-4;
                                HorizontalLayout {
                                    spacing: Theme.space-3;
                                    Text { text: "启动设置"; font-size: Theme.text-base; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button { text: "保存启动设置"; primary: !root.running && root.launcher-dirty; enabled: !root.running && !root.busy; clicked => { root.save-launcher(); } }
                                }
                                HorizontalLayout {
                                    spacing: Theme.space-3;
                                    Field { label: "服务程序"; value <=> root.executable; enabled: !root.running && !root.busy; edited => { root.launcher-dirty = true; } }
                                    VerticalLayout { alignment: end; Button { text: "选择程序"; width: 108px; enabled: !root.running && !root.busy; clicked => { root.choose-path(0); } } }
                                }
                                HorizontalLayout {
                                    spacing: Theme.space-3;
                                    Field { label: "工作目录"; value <=> root.working-directory; enabled: !root.running && !root.busy; edited => { root.launcher-dirty = true; } }
                                    VerticalLayout { alignment: end; Button { text: "选择目录"; width: 108px; enabled: !root.running && !root.busy; clicked => { root.choose-path(1); } } }
                                }
                                HorizontalLayout {
                                    spacing: Theme.space-3;
                                    Field { label: "配置文件"; value <=> root.config-path; enabled: !root.running && !root.busy; edited => { root.launcher-dirty = true; } }
                                    VerticalLayout { alignment: end; Button { text: "选择文件"; width: 108px; enabled: !root.running && !root.busy; clicked => { root.choose-path(2); } } }
                                }
                                Field { label: "本机服务地址"; value <=> root.base-url; enabled: !root.running && !root.busy; edited => { root.launcher-dirty = true; } }
                            }
                        }
                        // Card 2: Service runtime configuration
                        Rectangle {
                            background: Theme.surface-raised;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: Theme.radius-lg;
                            drop-shadow-blur: 3px;
                            drop-shadow-offset-y: 1px;
                            drop-shadow-color: Theme.shadow-subtle;
                            VerticalLayout {
                                padding: Theme.space-6;
                                spacing: Theme.space-4;
                                HorizontalLayout {
                                    spacing: Theme.space-2;
                                    Text { text: "服务配置"; font-size: Theme.text-base; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button { text: "重新读取"; enabled: root.connected && !root.busy; clicked => { if root.config-dirty { root.confirm-action(5); } else { root.read-config(); } } }
                                    Button { text: "保存服务配置"; primary: root.connected; enabled: root.connected && root.config-loaded && !root.busy; clicked => { root.save-config(); } }
                                }
                                if !root.connected: Rectangle {
                                    background: Theme.surface-subtle;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    border-radius: Theme.radius-md;
                                    HorizontalLayout {
                                        padding: Theme.space-4;
                                        Text { text: "启动服务后可读取并修改监听地址、线程数与日志配置。"; color: Theme.text-muted; font-size: Theme.text-sm; }
                                    }
                                }
                                if root.connected && root.restart-required && root.config-loaded: Rectangle {
                                    background: Theme.warning-surface;
                                    border-width: 1px;
                                    border-color: Theme.warning-border;
                                    border-radius: Theme.radius-md;
                                    clip: true;
                                    Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; background: Theme.warning; }
                                    HorizontalLayout {
                                        padding-left: Theme.space-4;
                                        padding-right: Theme.space-3;
                                        padding-top: Theme.space-3;
                                        padding-bottom: Theme.space-3;
                                        Text { text: "已保存的配置将在下次启动时生效"; color: Theme.warning-text; font-size: Theme.text-sm; }
                                    }
                                }
                                if root.connected: VerticalLayout {
                                    spacing: Theme.space-4;
                                    HorizontalLayout {
                                        spacing: Theme.space-4;
                                        Field { label: "监听 IP"; value <=> root.host; enabled: root.config-loaded && root.connected && !root.busy; edited => { root.config-dirty = true; } }
                                        Field { label: "监听端口"; value <=> root.port; enabled: root.config-loaded && root.connected && !root.busy; edited => { root.config-dirty = true; } }
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.space-4;
                                        Field { label: "工作线程（0为自动）"; value <=> root.workers; enabled: root.config-loaded && root.connected && !root.busy; edited => { root.config-dirty = true; } }
                                        Field { label: "数据库连接池"; value <=> root.pool-size; enabled: root.config-loaded && root.connected && !root.busy; edited => { root.config-dirty = true; } }
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.space-4;
                                        VerticalLayout {
                                            spacing: Theme.space-1;
                                            Text { text: "日志级别"; color: Theme.text-secondary; font-size: Theme.text-sm; font-weight: Theme.weight-semibold; }
                                            SelectBox { model: ["trace", "debug", "info", "warn", "error"]; current-index <=> root.log-level-index; enabled: root.config-loaded && root.connected && !root.busy; accessible-name: "日志级别"; selected => { root.config-dirty = true; } }
                                        }
                                        VerticalLayout {
                                            spacing: Theme.space-1;
                                            Text { text: "日志格式"; color: Theme.text-secondary; font-size: Theme.text-sm; font-weight: Theme.weight-semibold; }
                                            SelectBox { model: ["text", "json"]; current-index <=> root.log-format-index; enabled: root.config-loaded && root.connected && !root.busy; accessible-name: "日志格式"; selected => { root.config-dirty = true; } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        Rectangle {
            height: 28px;
            background: Theme.surface-subtle;
            HorizontalLayout {
                padding-left: Theme.space-4;
                padding-right: Theme.space-4;
                Text { text: "TeacherOA · 服务管理"; font-size: Theme.text-xs; color: Theme.text-muted; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.launcher-dirty || root.config-dirty ? "有未保存的修改" : ""; font-size: Theme.text-xs; font-weight: 600; color: Theme.warning-text; vertical-alignment: center; }
            }
        }
    }
}
