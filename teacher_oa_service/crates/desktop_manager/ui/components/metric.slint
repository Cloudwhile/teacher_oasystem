import { Theme } from "../tokens.slint";

// §2.5.3 + §8.5 Crisp institutional metric cell without heavy top roof bars.
export component Metric inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.text;
    in property <bool> show-dot: false;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-lg;
    drop-shadow-blur: 3px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: Theme.shadow-subtle;
    min-height: 84px;
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-2;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            if root.show-dot: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.value-color;
                }
            }
            Text {
                text: root.label;
                color: Theme.text-muted;
                font-size: Theme.text-xs;
                font-weight: 400;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.value;
            color: root.value-color;
            font-size: Theme.text-xl;
            font-weight: 600;
            overflow: elide;
        }
    }
}
