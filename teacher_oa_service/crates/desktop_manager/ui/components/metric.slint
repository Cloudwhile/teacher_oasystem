export component Metric inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: #182b43;
    background: #ffffff;
    border-width: 1px;
    border-color: #e1e7ef;
    border-radius: 6px;
    min-height: 100px;
    // Equal width per card regardless of value length.
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        Text { text: root.label; color: #69788b; font-size: 13px; }
        Text { text: root.value; color: root.value-color; font-size: 23px; font-weight: 600; overflow: elide; }
    }
}
