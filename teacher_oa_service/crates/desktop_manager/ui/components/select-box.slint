import { Theme } from "../tokens.slint";

// Custom Refactoring UI select box replacing std-widgets ComboBox (§8.1, §6.2.a).
export component SelectBox inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    in property <string> accessible-name;
    callback selected(string);

    height: 34px;
    min-width: 120px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-default;
    border-width: focus-scope.has-focus ? 2px : 1px;
    border-color: !root.enabled
        ? Theme.border
        : focus-scope.has-focus
            ? Theme.action
            : (touch.has-hover ? Theme.neutral-400 : Theme.border-strong);
    background: root.enabled ? Theme.surface-raised : Theme.surface-subtle;
    animate border-color { duration: 120ms; }
    animate background { duration: 120ms; }

    accessible-role: combobox;
    accessible-label: root.accessible-name;
    accessible-value: root.current-index >= 0 && root.current-index < root.model.length
        ? root.model[root.current-index]
        : "";
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            popup.show();
        }
    }

    focus-scope := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (!root.enabled) {
                return reject;
            }
            if (event.text == " " || event.text == "\n") {
                popup.show();
                return accept;
            }
            if (event.text == Key.UpArrow && root.current-index > 0) {
                root.current-index -= 1;
                root.selected(root.model[root.current-index]);
                return accept;
            }
            if (event.text == Key.DownArrow && root.current-index + 1 < root.model.length) {
                root.current-index += 1;
                root.selected(root.model[root.current-index]);
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                focus-scope.focus();
                popup.show();
            }
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-2;
        Text {
            text: root.current-index >= 0 && root.current-index < root.model.length
                ? root.model[root.current-index]
                : "";
            color: root.enabled ? Theme.text : Theme.text-muted;
            font-size: Theme.text-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Path {
                width: 10px;
                height: 6px;
                viewbox-width: 10;
                viewbox-height: 6;
                commands: "M 1 1 L 5 5 L 9 1";
                stroke: Theme.icon;
                stroke-width: 1.5px;
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.border-strong;
            border-radius: Theme.radius-default;
            drop-shadow-blur: 8px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: Theme.shadow-subtle;
            VerticalLayout {
                padding: Theme.space-1;
                spacing: 2px;
                for item[idx] in root.model: Rectangle {
                    height: 32px;
                    border-radius: Theme.radius-sm;
                    background: idx == root.current-index
                        ? Theme.action-subtle
                        : (item-touch.has-hover ? Theme.surface : transparent);
                    item-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.current-index = idx;
                            root.selected(item);
                        }
                    }
                    HorizontalLayout {
                        padding-left: Theme.space-3;
                        padding-right: Theme.space-3;
                        Text {
                            text: item;
                            font-size: Theme.text-sm;
                            font-weight: idx == root.current-index ? Theme.weight-semibold : Theme.weight-normal;
                            color: idx == root.current-index ? Theme.action-subtle-text : Theme.text;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
