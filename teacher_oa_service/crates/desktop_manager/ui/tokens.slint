// Generated from Refactoring UI design tokens (Workflow A + Workflow C refinement).
export global Theme {
    // Primary ramp (#1b56c4 base)
    out property <color> primary-100: #eff5fc;
    out property <color> primary-200: #cde0f7;
    out property <color> primary-400: #4b8ce3;
    out property <color> primary-500: #1b56c4;
    out property <color> primary-600: #1443ae;
    out property <color> primary-700: #0d3198;

    // Calm cool-slate neutral ramp
    out property <color> neutral-50: #fafbfc;
    out property <color> neutral-100: #f5f6f7;
    out property <color> neutral-200: #e3e5e8;
    out property <color> neutral-300: #c6cbd2;
    out property <color> neutral-400: #949aa4;
    out property <color> neutral-500: #737882;
    out property <color> neutral-600: #5c6069;
    out property <color> neutral-700: #43464e;
    out property <color> neutral-900: #1a1c21;

    // Semantic surfaces & text
    out property <color> surface: #f5f6f7;
    out property <color> surface-subtle: #fafbfc;
    out property <color> surface-raised: #ffffff;
    out property <color> surface-sunken: #e3e5e8;
    out property <color> text: #1a1c21;
    out property <color> text-secondary: #43464e;
    out property <color> text-muted: #5c6069;
    out property <color> border: #e3e5e8;
    out property <color> border-strong: #c6cbd2;

    // Semantic feedback
    out property <color> danger: #ad3236;
    out property <color> danger-surface: #fef1f2;
    out property <color> danger-border: #f9c6cb;
    out property <color> danger-text: #912326;
    out property <color> warning: #d07208;
    out property <color> warning-surface: #fef9ec;
    out property <color> warning-border: #fae4ab;
    out property <color> warning-text: #802d00;
    out property <color> success: #1b8053;
    out property <color> success-surface: #eefaf5;
    out property <color> success-border: #bcead5;
    out property <color> success-text: #10683b;

    // Spacing scale (§3.2.2)
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <color> shadow-subtle: #1011140a;
    out property <length> space-8: 32px;

    // Type scale (§4.1.1d)
    out property <length> text-xs: 12px;
    out property <length> text-sm: 14px;
    out property <length> text-base: 16px;
    out property <length> text-lg: 18px;
    out property <length> text-xl: 20px;
    out property <length> text-2xl: 24px;

    // Crisp institutional radii (§1.4.3)
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;
